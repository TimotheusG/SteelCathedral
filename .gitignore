# Unreal Engine gitignore

# Compiled binaries
Binaries/
Plugins/*/Binaries/

# Build files
Build/
Intermediate/
DerivedDataCache/
Saved/

# Visual Studio files
*.sln
*.suo
*.user
*.sdf
*.opensdf
*.db
*.opendb
*.VC.db
*.VC.opendb

# VS Code
.vscode/
.vs/

# Rider
.idea/
*.sln.iml

# Mac
.DS_Store

# Asset downloads (large files)
Content/Materials/Downloaded/
Content/HDRI/Downloaded/
Content/Meshes/Downloaded/
Content/ParagonHowitzer/Placeholder.txt

# Logs and generated files
*.log
Tools/asset_download_progress.txt
Tools/material_loading_code.txt
Tools/asset_config.json

# Unreal content (large binary assets stay outside git)
Content/

# Python cache
__pycache__/
*.pyc

# Secrets
git_token.txt
*.token
*.secret
